class Arithmetic_operators
{
	public static void main(String[] args) 
	{
		int  a =12;
		int b =34;


		int sum=a+b;
		int sub=a-b;
		int mul=a*b;
		int mod =a%b;
		int div = a/b;
		System.out.println(" sum = " +sum);
		System.out.println(" sub = "+sud);
		System.out.println("mul  ="+mul);
		System.out.println("mod  ="+mod);
		System.out.println("div  ="+div);
	}
}
